{
  "name": "ibu-receipts",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio of Mohamed Ibrahim A. (Ibu): every claim prints a receipt. Hosted on AWS Amplify.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "evidence": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-evidence.ts",
    "serve": "npm run build && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/serve.ts",
    "catalog": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/export-catalog.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
